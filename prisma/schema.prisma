generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
  TUTOR
  TECHNICIAN
}

enum VenueStatus {
  OPEN
  CLOSED
  IN_CLASS
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(STUDENT)
  sessions      Session[]
  bookings      Booking[]
  reports       Report[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Venue {
  id             String      @id @default(cuid())
  name           String      @unique
  currentStatus  VenueStatus @default(CLOSED)
  sessions       Session[]
  reports        Report[]
  lastUpdated    DateTime    @updatedAt
}

model Session {
  id          String    @id @default(cuid())
  venueId     String
  tutorId     String
  signInTime  DateTime  @default(now())
  signOutTime DateTime?

  venue       Venue     @relation(fields: [venueId], references: [id])
  tutor       User      @relation(fields: [tutorId], references: [id])
}

model Booking {
  id          String   @id @default(cuid())
  userId      String
  campusId    String
  campusName  String
  serviceName String
  bookingDate String
  bookingTime String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id        String   @id @default(cuid())
  tutorId   String
  venueId   String
  content   String
  status    String   @default("PENDING")
  timestamp DateTime @default(now())

  tutor     User     @relation(fields: [tutorId], references: [id])
  venue     Venue    @relation(fields: [venueId], references: [id])
}
