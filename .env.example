# =============================================================================
# TUT Lab Locator — environment variables (root Next.js app)
# =============================================================================
# Copy this file to `.env` in the repository root and fill in real values:
#
#     cp .env.example .env
#
# Use `.env` (not `.env.local`): both Next.js AND the Prisma CLI read `.env`,
# while the Prisma CLI ignores `.env.local`.
#
# `.env` is gitignored. NEVER commit real secrets. In production, set these in
# your hosting provider's environment settings (Vercel / Render dashboard)
# instead of using a file.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Local development uses SQLite. The path is relative to prisma/schema.prisma,
# so this points at prisma/prisma/dev.db.
DATABASE_URL="file:./prisma/dev.db"

# Production: SQLite is NOT durable on serverless hosts (Vercel, Render without
# a disk). Use hosted PostgreSQL instead — change `provider = "postgresql"` in
# prisma/schema.prisma and use a URL like:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lab_locator?sslmode=require"

# After changing the database or pulling schema changes, run:
#     npx prisma db push


# -----------------------------------------------------------------------------
# Authentication — NextAuth (required)
# -----------------------------------------------------------------------------
# The public base URL of the app, with no trailing slash. Also used to build
# links in emails (password reset, booking decisions).
#   Local:      http://localhost:3000
#   Production: https://your-app.vercel.app  (must be HTTPS)
NEXTAUTH_URL="http://localhost:3000"

# Secret used to sign session tokens. Must be long and random, and different
# for every environment. Changing it signs everyone out. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   or: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"


# -----------------------------------------------------------------------------
# Email — SMTP (required in production, optional locally)
# -----------------------------------------------------------------------------
# Used for password-reset links and booking approved/rejected notifications.
#
# Local development: leave SMTP_HOST empty and emails are printed to the
# terminal running `npm run dev` instead of being sent — copy the reset link
# from there.
#
# Production: if SMTP_HOST is empty, sending fails and the forgot-password page
# shows an error, so configure a real provider.
SMTP_HOST=""
# 587 = STARTTLS (most providers). 465 = implicit TLS (set SMTP_SECURE="true").
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# The "From" address students see. Many providers require this to be an
# address/domain you have verified with them.
MAIL_FROM="TUT Labs <no-reply@tut4life.ac.za>"

# Example — Gmail (needs 2-Step Verification and an App Password, not your
# normal password: https://myaccount.google.com/apppasswords):
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="your.address@gmail.com"
#   SMTP_PASSWORD="your-16-character-app-password"
#   MAIL_FROM="TUT Labs <your.address@gmail.com>"
#
# Example — Microsoft 365 / Outlook:
#   SMTP_HOST="smtp.office365.com"   SMTP_PORT="587"
#
# Example — a transactional provider (Resend, Brevo, SendGrid, Mailgun):
#   use the SMTP host, port, username and API key from their dashboard.
