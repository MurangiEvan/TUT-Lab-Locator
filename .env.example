# Copy to .env.local (root app) and fill in real values. Never commit real secrets.

# Prisma — path is relative to prisma/schema.prisma
DATABASE_URL="file:./prisma/dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Email (password reset). If SMTP_HOST is empty in development, reset links are
# printed to the server console instead of being emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="TUT Labs <no-reply@tut4life.ac.za>"
